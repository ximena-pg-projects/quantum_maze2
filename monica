            {
                start: { y: 0, x: 0 },
                key: { y: 4, x: 0 },
                nodes: [{ y: 2, x: 1 }],
                exit: { y: 0, x: 4 },
                humanMaze: [
                    ['', 'wall-r', '', '', 'pink-wall-b'],
                    ['', 'wall-r', '', '', ''],
                    ['', 'wall-b', '', 'wall-l', ''],
                    ['', '', '', '', ''],
                    ['', 'wall-r', '', '', '']
                ],
                aiMaze: [
                    ['', '', 'r', '', ''],
                    ['b', '', 'r', 'b', ''],
                    ['', '', '', '', ''],
                    ['r', '', 'b', '', 'r'],
                    ['', '', '', 'r', '']
                ],
                intro: "Level 2: Get Key at bottom-left (4,0), head to Node (2,1). Guide AI to navigate around unseen barriers to top-right exit!"
            },

            // Level 3: 狭窄通道与盲区绕行
            {
                start: { y: 0, x: 0 },
                key: { y: 0, x: 2 },
                nodes: [{ y: 4, x: 2 }],
                exit: { y: 4, x: 4 },
                humanMaze: [
                    ['wall-b', '', '', 'wall-b', ''],
                    ['', 'wall-r', 'wall-r', '', ''],
                    ['', 'wall-b', '', 'wall-b', ''],
                    ['wall-r', '', '', '', 'pink-wall-r'],
                    ['', '', '', '', '']
