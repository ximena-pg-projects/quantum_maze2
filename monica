                aiMaze: [
                    ['', 'r', '', '', ''],
                    ['', '', '', '', 'b'],
                    ['r', '', 'r', '', ''],
                    ['', 'b', '', 'r', ''],
                    ['', '', '', '', '']
                ],
                intro: "Level 3: Precise routing required. Reach key at (0,2), walk to bottom Node (4,2), and direct AI through narrow pink gate."
            },

            // Level 4: 两次控制权转换 (Player -> AI -> Player -> AI)
            {
                start: { y: 0, x: 0 },
                key: { y: 2, x: 4 },
                nodes: [{ y: 1, x: 1 }, { y: 3, x: 3 }],
                exit: { y: 4, x: 0 },
                humanMaze: [
                    ['', '', 'wall-r', '', ''],
                    ['', '', '', 'wall-b', ''],
