            },

            // Level 5: 迷宫隔断 + 双向锁墙
            {
                start: { y: 4, x: 0 },
                key: { y: 0, x: 0 },
                nodes: [{ y: 2, x: 4 }],
                exit: { y: 4, x: 4 },
                humanMaze: [
                    ['', 'wall-r', '', '', ''],
                    ['wall-b', '', 'wall-r', '', 'pink-wall-b'],
                    ['', '', 'wall-b', '', ''],
                    ['', 'wall-r', '', 'wall-l', ''],
                    ['', '', '', '', '']
                ],
                aiMaze: [
                    ['', '', 'b', '', 'r'],
                    ['', 'r', '', '', ''],
                    ['r', '', '', 'b', ''],
                    ['', '', 'r', '', ''],
                    ['', 'b', '', '', '']
                ],
                intro: "Level 5: Start at bottom-left! Reach top-left Key (0,0), detour to Node (2,4) and clear the pink obstruction."
            },

            // Level 6: 终极双盲阵列 (全面复杂关卡)
            {
                start: { y: 0, x: 0 },
                key: { y: 4, x: 2 },
                nodes: [{ y: 0, x: 4 }, { y: 2, x: 0 }],
                exit: { y: 4, x: 4 },
                humanMaze: [
                    ['', 'wall-b', '', '', ''],
                    ['wall-r', '', 'wall-b', 'wall-r', ''],
                    ['', '', '', '', 'pink-wall-b'],
                    ['', 'wall-r', 'wall-t', '', ''],
                    ['', '', '', 'pink-wall-r', '']
                ],
                aiMaze: [
                    ['', 'r', '', 'b', ''],
                    ['b', '', '', '', 'r'],
                    ['', 'r', 'b', '', ''],
                    ['', '', '', 'r', ''],
                    ['r', '', '', '', '']
                ],
                intro: "Level 6 [MASTER]: Final challenge! Synchronize dual perspectives with multiple locks and invisible barrier grid."
            }
        ];

        let state = {
            pos: { y: 0, x: 0 },
            hasKey: false,
            controller: 'human',
            isGameOver: false
        };

        const grid = document.getElementById('grid-container');
        const token = document.getElementById('token');
        const chatWindow = document.getElementById('chat-window');
        const chatInput = document.getElementById('chat-input');
        const btnSend = document.getElementById('btn-send');
        const btnTransfer = document.getElementById('btn-transfer');
        const controlStatus = document.getElementById('control-status');
        const keyStatusText = document.getElementById('key-status-text');
        const winOverlay = document.getElementById('win-overlay');
        const levelNumDom = document.getElementById('level-num');

        function loadLevel(idx) {
            currentLevelIndex = idx;
            const lvl = LEVELS[idx];
            
            state.pos = { ...lvl.start };
            state.hasKey = false;
            state.controller = 'human';
            state.isGameOver = false;

            levelNumDom.innerText = idx + 1;
            winOverlay.style.display = 'none';

            renderGrid();
            updateUI();

            chatWindow.innerHTML = '';
            addMessage('ai', lvl.intro);
            addMessage('sys', 'Use Arrow Keys to move.');
        }

        function restartLevel() {
            loadLevel(currentLevelIndex);
        }

        function nextLevel() {
            if (currentLevelIndex + 1 < LEVELS.length) {
                loadLevel(currentLevelIndex + 1);
            } else {
                loadLevel(0); // 重新开始
            }
        }

        function renderGrid() {
            const lvl = LEVELS[currentLevelIndex];
            grid.querySelectorAll('.cell').forEach(c => c.remove());

            for (let y = 0; y < GRID_SIZE; y++) {
                for (let x = 0; x < GRID_SIZE; x++) {
                    const cell = document.createElement('div');
                    cell.className = `cell ${lvl.humanMaze[y][x]}`;

                    if (!state.hasKey && lvl.key.y === y && lvl.key.x === x) {
                        const keyDom = document.createElement('div');
                        keyDom.className = 'key-item';
                        cell.appendChild(keyDom);
                    }

                    if (lvl.nodes.some(n => n.y === y && n.x === x)) {
                        const nodeDom = document.createElement('div');
                        nodeDom.className = 'node';
                        cell.appendChild(nodeDom);
                    }

                    if (lvl.exit.y === y && lvl.exit.x === x) {
                        const exitDom = document.createElement('div');
                        exitDom.className = 'exit';
                        cell.appendChild(exitDom);
                    }

                    grid.appendChild(cell);
                }
            }
        }

        function isWallBetween(y1, x1, y2, x2, wallSet) {
            if (y2 < 0 || y2 >= GRID_SIZE || x2 < 0 || x2 >= GRID_SIZE) return true;

            const str1 = wallSet[y1][x1];
            const str2 = wallSet[y2][x2];

            if (y2 < y1) return str1.includes('t') || str1.includes('wall-t') || str2.includes('b') || str2.includes('wall-b');
            if (y2 > y1) return str1.includes('b') || str1.includes('wall-b') || str2.includes('t') || str2.includes('wall-t');
            if (x2 < x1) return str1.includes('l') || str1.includes('wall-l') || str2.includes('r') || str2.includes('wall-r');
            if (x2 > x1) return str1.includes('r') || str1.includes('wall-r') || str2.includes('l') || str2.includes('wall-l');
            return false;
        }

        function attemptMove(dir) {
            if (state.isGameOver) return;

            const lvl = LEVELS[currentLevelIndex];
            const cur = state.pos;
            let next = { y: cur.y, x: cur.x };

            switch (dir) {
                case 'up': next.y--; break;
                case 'down': next.y++; break;
                case 'left': next.x--; break;
                case 'right': next.x++; break;
            }

            if (next.y < 0 || next.y >= GRID_SIZE || next.x < 0 || next.x >= GRID_SIZE) {
                notifyBlocked("Boundary hit.");
                return;
            }

            const blockedHuman = isWallBetween(cur.y, cur.x, next.y, next.x, lvl.humanMaze);
            const blockedAi = isWallBetween(cur.y, cur.x, next.y, next.x, lvl.aiMaze);

            const isPink = lvl.humanMaze[cur.y][cur.x].includes('pink') || lvl.humanMaze[next.y][next.x].includes('pink');

            if (isPink) {
                if (state.hasKey) {
                    lvl.humanMaze[cur.y][cur.x] = lvl.humanMaze[cur.y][cur.x].replace(/pink-wall-[tblr]/g, '');
                    lvl.humanMaze[next.y][next.x] = lvl.humanMaze[next.y][next.x].replace(/pink-wall-[tblr]/g, '');
                    state.hasKey = false;
                    addMessage('sys', 'Pink Wall unlocked with Key!');
                    addMessage('ai', 'Passage clear! Proceed to exit!');
                } else {
                    notifyBlocked("Pink wall locked! Get [Key] first!");
                    return;
                }
            } else if (blockedHuman) {
                notifyBlocked("Hit visible cyan wall.");
                return;
            } else if (blockedAi && state.controller === 'ai') {
                addMessage('ai', `Hidden obstacle heading ${dir}. Try alternative turn!`);
                return;
            }

            state.pos = next;

            if (!state.hasKey && next.y === lvl.key.y && next.x === lvl.x) {
                // Key pick up
            }
            if (!state.hasKey && next.y === lvl.key.y && next.x === lvl.key.x) {
                state.hasKey = true;
                addMessage('sys', 'Key acquired!');
                addMessage('ai', 'Key secured! Find Green Node to pass control!');
            }

            renderGrid();
            updateUI();

            if (next.y === lvl.exit.y && next.x === lvl.exit.x) {
                triggerWin();
            }
        }

        function notifyBlocked(txt) {
            if (state.controller === 'human') addMessage('sys', txt);
            else addMessage('ai', txt);
        }

        function triggerWin() {
            state.isGameOver = true;
            addMessage('sys', `Level ${currentLevelIndex + 1} Cleared!`);
            
            if (currentLevelIndex + 1 >= LEVELS.length) {
                document.getElementById('win-title').innerText = "CAMPAIGN COMPLETE!";
                document.getElementById('win-sub').innerText = "You successfully solved all 6 Biphasic link levels!";
                document.getElementById('btn-next').innerText = "Play Again";
            } else {
                document.getElementById('win-title').innerText = `Level ${currentLevelIndex + 1} Cleared!`;
                document.getElementById('win-sub').innerText = "Data link synchronized. Next chamber unlocked.";
                document.getElementById('btn-next').innerText = "Next Level";
            }
            setTimeout(() => winOverlay.style.display = 'flex', 300);
        }

        function updateUI() {
            const topPos = state.pos.y * CELL_PIXEL_SIZE + (CELL_PIXEL_SIZE - 26) / 2;
            const leftPos = state.pos.x * CELL_PIXEL_SIZE + (CELL_PIXEL_SIZE - 26) / 2;
            token.style.top = `${topPos}px`;
            token.style.left = `${leftPos}px`;

            if (state.controller === 'human') {
                controlStatus.innerText = "You";
                controlStatus.style.color = "var(--human-color)";
                token.className = '';
                chatInput.disabled = false;
                chatInput.placeholder = "Type message or command...";
            } else {
                controlStatus.innerText = "Adam (AI)";
                controlStatus.style.color = "var(--ai-color)";
                token.className = 'token-ai';
                chatInput.placeholder = "Command AI (up, down, left, right)...";
            }

            keyStatusText.innerText = state.hasKey ? "Collected" : "Missing";

            const lvl = LEVELS[currentLevelIndex];
            const isOnNode = lvl.nodes.some(n => n.y === state.pos.y && n.x === state.pos.x);

            if (isOnNode && !state.isGameOver) {
                btnTransfer.classList.add('active');
                btnTransfer.disabled = false;
            } else {
                btnTransfer.classList.remove('active');
                btnTransfer.disabled = true;
            }
        }

        function addMessage(sender, text) {
            const msgDiv = document.createElement('div');
            msgDiv.className = `message ${sender}`;
            msgDiv.innerText = text;
            chatWindow.appendChild(msgDiv);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        function handleSendMessage() {
            const text = chatInput.value.trim().toLowerCase();
            if (!text) return;

            addMessage('human', text);
            chatInput.value = '';

            if (state.controller === 'ai') {
                parseAiCommand(text);
            } else {
                setTimeout(() => addMessage('ai', 'Acknowledged. Use arrow keys to navigate.'), 350);
            }
        }

        function parseAiCommand(text) {
            let matched = false;
