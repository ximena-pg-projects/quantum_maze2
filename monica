    </div>

    <script>
        const GRID_SIZE = 5;
        const CELL_PIXEL_SIZE = 80;

        let currentLevelIndex = 0;

        // 6 个关卡数据库 (完全平滑解密，独立无死角)
        const LEVELS = [
            // Level 1: 基础认知 (直路拿钥匙 -> 节点 -> AI开门)
